{
  // Options shared by the client (browser) and server (Node) projects.
  // Imports keep their .ts extension: Node runs the server's TypeScript
  // directly (type stripping), so only erasable syntax is allowed.
  "compilerOptions": {
    "target": "ES2023",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  }
}
