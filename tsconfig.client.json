{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.client.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/client/*"]
    }
  },
  "include": ["src/client", "src/shared"],
  // The service worker has its own project (it runs in a worker, not in a page).
  "exclude": ["src/client/sw.ts"]
}
