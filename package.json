{
  "name": "scrapytube",
  "version": "0.1.0",
  "private": true,
  "description": "ScrapyTube – a mobile-first YouTube downloader (MP4 or MP3) run on a NAS.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:server": "node scripts/dev.ts server",
    "dev:web": "node scripts/dev.ts web",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "serve": "vite build && DATA_DIR=./data MEDIA_DIR=./media node src/server/main.ts",
    "test": "vitest --run",
    "typecheck": "tsc -b",
    "icons": "node scripts/icons.ts",
    "reset-password": "DATA_DIR=./data node src/server/cli/reset-password.ts",
    "docker:build": "bash scripts/docker-build.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.17.1"
}
